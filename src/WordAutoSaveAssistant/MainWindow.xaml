<Window x:Class="WordAutoSaveAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word 定时保存助手 v1.4.2" Icon="Assets/AppIcon.png" Width="920" Height="810" MinWidth="780" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F3F5F9" Foreground="#1B2940"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        StateChanged="Window_StateChanged" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="600"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E3E8EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8CAFF9"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" CornerRadius="9,9,0,0" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#2563EB"/><Setter TargetName="TabBorder" Property="Background" Value="White"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#2563EB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ResultItemTemplate">
            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding HelpText}" AutomationProperties.Name="{Binding DisplayName}"
                       AutomationProperties.HelpText="{Binding HelpText}" TextTrimming="CharacterEllipsis" Margin="0,5"/>
        </DataTemplate>
        <Style x:Key="ResultListStyle" TargetType="ListBox">
            <Setter Property="Height" Value="96"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,20">
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="Assets/AppIcon.png" Width="48" Height="48" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Word 定时保存助手" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="安心编辑，让保存按时发生" Foreground="#7B8799" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#E9EEF5" CornerRadius="20" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#98A2B3" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="已停止"/></StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="保存频率" FontSize="12" Foreground="#7B8799" Margin="0,0,0,9"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="IntervalBox" Width="76" Height="40" FontSize="19" Padding="10,5" Background="#F8FAFC" BorderBrush="#D9E1ED" BorderThickness="1" VerticalContentAlignment="Center" TextChanged="IntervalBox_TextChanged" AutomationProperties.Name="保存间隔（分钟）"/>
                            <TextBlock Text="分钟 / 次" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock x:Name="IntervalErrorText" Foreground="#C2413B" Visibility="Collapsed" Margin="0,6,0,0" FontSize="11"/>
                        <TextBlock x:Name="SettingsWarningText" Foreground="#AD6212" Visibility="Collapsed" Margin="0,6,8,0" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="距离下次保存" FontSize="12" Foreground="#7B8799"/>
                        <TextBlock x:Name="CountdownText" Text="--" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Button x:Name="StartStopButton" Content="开始" Height="42" Margin="0,4,0,8" Click="StartStopButton_Click"/>
                        <Button x:Name="SaveOnceButton" Content="立即保存一次" Height="36" Padding="12,6" Background="#EEF3FC" Foreground="#2563EB" Click="SaveOnceButton_Click" ToolTip="仅执行一轮，不启动定时，也不改变运行中的倒计时。"/>
                        <TextBlock x:Name="LastSaveText" Text="尚未执行" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="ResultsTabs" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,16">
                <TabItem Header="当前文档">
                    <Border Style="{StaticResource Card}" CornerRadius="0,14,14,14" Padding="18" Height="340">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="InventorySummaryText" Text="尚未完成检测" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="InventoryTimeText" FontSize="11" Foreground="#7B8799" Margin="0,5,0,12"/>
                                </StackPanel>
                                <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新列表" Background="#EEF3FC" Foreground="#2563EB" Padding="14,8" VerticalAlignment="Top" Click="RefreshButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="ConnectionWarningText" Grid.Row="1" FontSize="11" Foreground="#AD6212" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding InventorySnapshot.Items}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                      RowHeight="49" ColumnHeaderHeight="30" BorderThickness="0" Background="White" AlternatingRowBackground="#F8FAFC"
                                      SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF2F8"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="Padding" Value="10,5"/><Setter Property="BorderThickness" Value="0"/></Style>
                                    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                                    <Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding HelpText}"/><Setter Property="AutomationProperties.Name" Value="{Binding DocumentName}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}"/></Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="文档名称 / 位置" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DocumentName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FullPath}" FontSize="10" Foreground="#7B8799" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="当前状态" Width="168"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding State}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#41648D"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="InventoryEmptyText" Grid.Row="2" Text="正在检测…" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#7B8799" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="最近一轮">
                    <Border Style="{StaticResource Card}" Padding="18" Height="340">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="DetectionText" Text="尚未执行" FontSize="12" Foreground="#7B8799" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                                <Border Background="#EDF8F2" CornerRadius="10" Padding="14,10" Margin="0,0,6,6"><StackPanel>
                                    <DockPanel><TextBlock Text="{Binding RoundSnapshot.Saved.Count}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#16845C" FontWeight="Bold"/><TextBlock Text="已保存" Foreground="#16845C" FontWeight="SemiBold"/></DockPanel>
                                    <ListBox ItemsSource="{Binding RoundSnapshot.Saved.Items}" ItemTemplate="{StaticResource ResultItemTemplate}" Style="{StaticResource ResultListStyle}" PreviewMouseWheel="ResultList_PreviewMouseWheel"/>
                                </StackPanel></Border>
                                <Border Background="#EEF4FC" CornerRadius="10" Padding="14,10" Margin="6,0,0,6"><StackPanel>
                                    <DockPanel><TextBlock Text="{Binding RoundSnapshot.Unchanged.Count}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#41648D" FontWeight="Bold"/><TextBlock Text="无需保存" Foreground="#41648D" FontWeight="SemiBold"/></DockPanel>
                                    <ListBox ItemsSource="{Binding RoundSnapshot.Unchanged.Items}" ItemTemplate="{StaticResource ResultItemTemplate}" Style="{StaticResource ResultListStyle}" PreviewMouseWheel="ResultList_PreviewMouseWheel"/>
                                </StackPanel></Border>
                                <Border Background="#FFF7E9" CornerRadius="10" Padding="14,10" Margin="0,6,6,0"><StackPanel>
                                    <DockPanel><TextBlock Text="{Binding RoundSnapshot.Skipped.Count}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#AD6212" FontWeight="Bold"/><TextBlock Text="已跳过" Foreground="#AD6212" FontWeight="SemiBold"/></DockPanel>
                                    <ListBox ItemsSource="{Binding RoundSnapshot.Skipped.Items}" ItemTemplate="{StaticResource ResultItemTemplate}" Style="{StaticResource ResultListStyle}" PreviewMouseWheel="ResultList_PreviewMouseWheel"/>
                                </StackPanel></Border>
                                <Border Background="#FFF0EE" CornerRadius="10" Padding="14,10" Margin="6,6,0,0"><StackPanel>
                                    <DockPanel><TextBlock Text="{Binding RoundSnapshot.Failed.Count}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#C2413B" FontWeight="Bold"/><TextBlock Text="失败" Foreground="#C2413B" FontWeight="SemiBold"/></DockPanel>
                                    <ListBox ItemsSource="{Binding RoundSnapshot.Failed.Items}" ItemTemplate="{StaticResource ResultItemTemplate}" Style="{StaticResource ResultListStyle}" PreviewMouseWheel="ResultList_PreviewMouseWheel"/>
                                </StackPanel></Border>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <Border Style="{StaticResource Card}" Padding="18,12">
                <StackPanel>
                    <TextBlock Text="最近的跳过 / 失败记录" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="仅保留本次运行的最近 5 条，不写入磁盘" FontSize="10" Foreground="#7B8799" Margin="0,3,0,6"/>
                    <ListBox x:Name="RecentEventsList" MaxHeight="95" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            <TextBlock x:Name="FooterText" Foreground="#7B8799" FontSize="11" TextWrapping="Wrap" Margin="2,12,2,0"/>
            <TextBlock Text="作者：LGH   ·   赞助商：ZHZ" Foreground="#7B8799" FontSize="11" Margin="2,6,2,0" HorizontalAlignment="Right"/>
        </StackPanel>
    </ScrollViewer>
</Window>
